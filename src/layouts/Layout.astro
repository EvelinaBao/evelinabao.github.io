---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
const { title = 'Evelina Bao' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" />
		<meta name="generator" content={Astro.generator} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,500;9..144,600&family=IBM+Plex+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
		<title>{title}</title>
	</head>
	<body class="bg-paper font-body text-ink">
		<Nav />
		<slot />
		<footer id="contact" class="border-t border-line">
			<div class="mx-auto max-w-5xl px-6 py-20 text-center">
				<h2 class="font-display text-3xl text-ink">Let's connect!</h2>
				<p class="mx-auto mt-4 max-w-prose text-muted">
				Completing my PhD in May 2028 and open to conversations about research
				scientist, quantitative UXR, and data science roles.
				</p>
				<a href="mailto:evelina.bao@nyu.edu" class="mt-8 inline-block rounded-lg bg-lavender px-6 py-3 text-sm font-medium text-white hover:bg-lavender-deep">
				evelina.bao@nyu.edu
				</a>
				<div class="mt-10 flex flex-wrap justify-center gap-6 text-sm text-muted">
				<a href="https://www.linkedin.com/in/yun-evelina-bao-a2b8b6351/" class="hover:text-lavender-deep">LinkedIn</a>
				<a href="https://github.com/EvelinaBao" class="hover:text-lavender-deep">GitHub</a>
				<a href="https://scholar.google.com/citations?user=N3jFHiEAAAAJ&hl=en&oi=ao" class="hover:text-lavender-deep">Google Scholar</a>
				<a href="/resume.pdf" class="hover:text-lavender-deep">Resume</a>
				<a href="/cv.pdf" class="hover:text-lavender-deep">CV</a>
				</div>
				<p class="mt-10 text-xs text-muted/70">© 2026 Yun (Evelina) Bao</p>
			</div>
		</footer>
	</body>
</html>

<style>
	html,
	body {
		margin: 0;
		width: 100%;
		height: 100%;
	}
</style>
