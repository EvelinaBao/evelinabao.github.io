---
import ProjectFigure from "./ProjectFigure.astro";
const { title, description, stat, methods, image, figure, href } = Astro.props;
---
<a href={href} class="block overflow-hidden rounded-2xl border border-line bg-card hover:border-lavender-soft hover:-translate-y-0.5 transition">
  
    <div class="bg-lavender-soft/20">
        {image
            ? <img src={image} alt={title} class="w-full aspect-[3/1] object-contain block" />
            : <ProjectFigure figure={figure} />}
    </div>
    <div class="p-6">
        <h3 class="font-display text-xl text-ink">{title}</h3>
        <p class="mt-2 text-sm text-muted leading-relaxed">{description}</p>
        {stat
            ? <p class="mt-4 text-sm font-medium text-lavender-deep">{stat}</p>
            : methods && <p class="mt-4 text-sm font-medium text-lavender-deep">{methods}</p>}
        <p class="mt-4 text-sm font-medium text-lavender-deep">Case study →</p>
  </div>
</a>