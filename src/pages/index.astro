---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { getCollection } from 'astro:content';

function statusStyle(status) {
  if (status === "published") return "bg-lavender-deep text-paper";
  if (status === "in preparation") return "bg-periwinkle text-paper";
  if (status === "under review") return "bg-slate text-paper";
  if (status.startsWith("R&R")) return "bg-blue-deep text-paper";
  return "bg-line/60 text-muted";
}

const projects = (await getCollection('projects')).sort(
  (a, b) => a.data.order - b.data.order
);

const publications = (await getCollection('publications')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Layout title="Evelina Bao">
	<section class="mx-auto max-w-5xl px-6 py-20 grid md:grid-cols-[1.3fr_1fr] gap- items-center">
		<div>
			<p class="text-5xl font-semibold font-display text-ink">Evelina Bao</p>
			<h1 class="font-display text-3xl leading-tight text-ink">
			Why do millions of people suddenly feel — and act — as one?
			</h1>
			<p class="mt-6 text-lg text-muted leading-relaxed max-w-prose">
			I'm Evelina Bao, a computational social scientist. I use NLP, large language models, and network science to study how emotions spread through communities and turn into collective action.
			</p>
			<div class="mt-8 flex gap-3">
			<a href="/projects" class="rounded-lg bg-lavender px-5 py-2.5 text-sm font-medium text-white hover:bg-lavender-deep">
				See my work
			</a>
			<a href="/resume.pdf" class="rounded-lg border border-line px-5 py-2.5 text-sm font-medium text-ink hover:bg-lavender/10">
				Resume (PDF)
			</a>
			</div>
		</div>

		<div class="justify-self-center w-64 aspect-[4/5] overflow-hidden rounded-2xl border border-line bg-lavender-soft">
			<img
				src="/headshot.jpg"
				alt="Portrait of Evelina Bao"
				class="w-full h-full object-cover scale-150"
			/>
		</div>
	</section>

	<section class="mx-auto max-w-5xl px-6">
		<h2 class="font-display text-3xl text-ink">Selected work</h2>
		<div class="mt-8 grid gap-6 md:grid-cols-2">
			{projects.map((project) => (
				<ProjectCard
					title={project.data.title}
					description={project.data.description}
					stat={project.data.stat}
					methods={project.data.methods}
					figure={project.data.figure}
					image={project.data.image}
					href={`/projects/${project.id}`}
				/>
			))}
		</div>
	</section>

	<section id="about" class="mx-auto max-w-5xl px-6 py-16">
		<h2 class="font-display text-3xl text-ink">About</h2>
		<div class="mt-8 grid gap-10 md:grid-cols-[1.4fr_1fr]">
			<div>
			<p class="font-display text-2xl leading-snug text-ink">
				"Beyond building tools, I want to use them creatively to answer complex questions."
			</p>
			<p class="mt-5 text-muted leading-relaxed">
				I'm a PhD candidate in Social Psychology at NYU with a minor in Quantitative
				Psychology, and dual bachelor's degrees in Computer Science and Psychology
				from USC. Off duty: traveling, restaurant hunting, guitar, film, and
				story-driven games.
			</p>
			</div>
			<div class="space-y-3">
			<div class="rounded-2xl border border-line bg-card p-4 text-sm">
				<p class="font-medium text-ink">PhD, Social Psychology</p>
				<p class="text-muted">New York University · expected May 2028</p>
			</div>
			<div class="rounded-2xl border border-line bg-card p-4 text-sm">
				<p class="font-medium text-ink">B.S. Computer Science & B.A. Psychology</p>
				<p class="text-muted">University of Southern California</p>
			</div>
			<div class="rounded-2xl border border-line bg-card p-4 text-sm">
				<p class="font-medium text-ink">Research across three labs</p>
				<p class="text-muted">NYU · Stanford · Harvard collaborations</p>
			</div>
			</div>
		</div>
	</section>

	<section id="publications" class="mx-auto max-w-5xl px-6 py-16">
		<h2 class="font-display text-3xl text-ink">Publications</h2>
		<ul class="mt-8 divide-y divide-line">
			{publications.map((pub) => (
			<li class="flex flex-wrap items-baseline justify-between gap-3 py-4 text-sm">
				<span class="max-w-prose text-muted">{pub.data.citation}</span>
				<span class={`whitespace-nowrap rounded-full px-3 py-1 text-xs font-medium ${statusStyle(pub.data.status)}`}>
  						{pub.data.status}
				</span>
			</li>
			))}
		</ul>
	</section>

	
</Layout>
